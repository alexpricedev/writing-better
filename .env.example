# All variables are required
#
# This file is the development template. Tests don't read it or a copy of it:
# every value the suite needs is pinned by src/server/test-utils/test-env.ts,
# which bunfig.toml preloads into each test file.

PORT=3000
APP_NAME=Writing Better

# Must include the port — it is the origin the app builds absolute links from.
APP_URL=http://localhost:3000

# Optional — Contact for /.well-known/security.txt. A bare email is wrapped in
# mailto:; a mailto:/https:/tel: URI is used as-is. Defaults to a placeholder
# (security@<your SITE_URL host>). Set a monitored address before launch.
# See runbooks/SECURITY.md §2.
# SECURITY_CONTACT=security@yourdomain.com

# Optional — set to "true" to serve a 503 "under maintenance" page (with a
# Retry-After header) for every request except the /health check. An app-level
# fallback; prefer flipping maintenance at your edge/CDN when you can, since the
# app is what you're taking offline. MAINTENANCE_RETRY_AFTER overrides the
# Retry-After value in seconds (default 3600).
# MAINTENANCE_MODE=true
# MAINTENANCE_RETRY_AFTER=3600

# Optional — set to "true" when the app runs behind exactly one reverse proxy that
# rewrites or appends to x-forwarded-for itself (Railway does). The rate limiter
# then keys on the last entry of that header — the hop the proxy added — instead of
# the socket address, which behind a proxy is the proxy. Off by default: without a
# proxy in front, the header is client-controlled and trusting it lets anyone walk
# past the limiter with a fresh value per request. Any value other than
# "true"/"false" stops the server at boot.
# TRUST_PROXY=true
